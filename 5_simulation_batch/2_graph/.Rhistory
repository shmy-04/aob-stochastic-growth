europaea = "italic('N. europaea')",
PY1 = "italic('Nitrosomonas')~'sp. PY1'",
`10^5` = "10^5",
`10^3` = "10^3",
`10^1` = "10^1",
`10^0` = "0",
`CFS+` = "'CFS+'",
`CFS-` = "'CFS-'",
`1` = "'N = 1'",
`2` = "'N = 2'",
`3` = "'N = 3'",
`noCFS_Cat` = "'CFS -'",
`noCFS_noCat` = "'CFS -,'~'catalase-'"
), default = label_parsed)
folder_path = "./result/"
if (!dir.exists(folder_path)) {
dir.create(folder_path, recursive = TRUE)
}
