base_name <- "(supple)population-level_growth_heterogeneity"
ggsave(file.path(folder_path, paste0(base_name, ".svg")),
plot = boxplot, width = 4.8, height = 4.8, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, ".pdf")),
plot = boxplot, width = 4.8, height = 4.8, units = "in", device = "pdf", dpi = 600)
}
