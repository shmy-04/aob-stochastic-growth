specie_list = c("europaea", "PY1")
deltaVt_plots <- list()
for (specie in specie_list){
data = subset(biomass_data, Condition != "supernatant" & Specie == specie)
deltaVt_plot <-
plot_time_vs_biomassProduction_mergeRep(na.omit(data))
base_name <- "(exstra)_time_vs_biomassProduction"
deltaVt_plot <- deltaVt_plot+mytheme_paper+
theme(legend.position = "inside",
legend.position.inside = c(0.03, 0.97),
legend.justification = c(0, 1),
legend.title = element_text(family = "Helvetica", size = 6, color = "black", margin = margin(b = 3)),
legend.key.height = unit(0.25, "cm"),
legend.spacing.y = unit(0, "cm")
)
deltaVt_plots[[specie]] <- deltaVt_plot
ggsave(file.path(folder_path, paste0(base_name, "_", specie,  ".svg")),
plot = deltaVt_plot, width = 2.4, height = 2.4, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, "_", specie, ".png")),
plot = deltaVt_plot, width = 2.4, height = 2.4, units = "in", device = "png", dpi = 600)
}
specie_list = c("PY1")
deltaVt_plots_CFS <- list()
for (specie in specie_list){
data = subset(biomass_data, Condition == "supernatant" & Specie == specie)
deltaVt_plot <-
plot_time_vs_biomassProduction_mergeRep(na.omit(data))
base_name <- "(exstra)_time_vs_biomassProduction_CFS"
deltaVt_plot <- deltaVt_plot+mytheme_paper
deltaVt_plots_CFS[[specie]] <- deltaVt_plot
ggsave(file.path(folder_path, paste0(base_name, "_", specie,  ".svg")),
plot = deltaVt_plot, width = 2.4, height = 2.4, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, "_", specie, ".png")),
plot = deltaVt_plot, width = 2.4, height = 2.4, units = "in", device = "png", dpi = 600)
}
library(patchwork)
figS8 <- (
(biomass_plots[["PY1"]] / elongation_rate_plots[["PY1"]] / deltaVt_plots[["PY1"]] ) |
(biomass_plots[["europaea"]] / elongation_rate_plots[["europaea"]] / deltaVt_plots[["europaea"]])
)+
plot_annotation(tag_levels = 'A')
base_name = "figS8"
# save
ggsave(file.path(folder_path, paste0(base_name, ".svg")),
figS8, width = 6.4, height = 7.2, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, ".png")),
figS8, width = 6.4, height = 7.2, units = "in", device = "png", dpi = 600)
# Clear global workspace
rm( list = ls( envir = globalenv() ), envir = globalenv() )
library("ggthemes")
library("tidyverse")
library("patchwork")
library("export")
library("e1071")
library("scales")
library("RColorBrewer")
library("zoo")
library("plotly")
library("dplyr")
library("ggpmisc")
library("ggh4x")
file = "../1_fit_summarize_rawdata/processed_data/5_summary_data_exponential.csv"
summarize_data <- read.csv(file, header = TRUE)
summarize_data_G0 <- summarize_data %>% filter(generation_count == 0)
summarize_data_Gn <- summarize_data %>% filter(generation_count != 0)
file_2 = "../1_fit_summarize_rawdata/processed_data/3_biomass_data.csv"
biomass_data <- read.csv(file_2, header = TRUE)
biomass_data_mutate <-
biomass_data %>%
group_by(Specie, Condition, replicate, Time) %>%
filter(n_distinct(FOV) == 3) %>%
summarise(mean_mean_elongation_rateb = mean(mean_elongation_rate, na.rm = TRUE),
sd_elongation_rate = sd(mean_elongation_rate, na.rm = TRUE),
mean_um2_biomass = mean(um2_biomass, na.rm = TRUE),
sd_um2_biomass = sd(um2_biomass, na.rm = TRUE),
mean_um3_biomass_production_density = mean(um3_biomass_production_density, na.rm = TRUE),
sd_um3_biomass_production_density = sd(um3_biomass_production_density, na.rm = TRUE),
)
file_3 = "../1_fit_summarize_rawdata/processed_data/6_daughter_cell_pair.csv"
daughter_cell_pair <- read.csv(file_3, header = TRUE)
# define mytheme
mytheme_paper <-
theme(text = element_text(family = "Helvetica", size=8, color = "black"),
plot.title = element_text(family = "Helvetica", size=9.5, color = "black", face = "bold",
vjust = 1, hjust = 0),
axis.title.x = element_text(family = "Helvetica", size=8, color = "black",
margin = margin(t = 5)),
axis.title.y = element_text(family = "Helvetica", size=8, color = "black", angle = 90,
margin = margin(r = 5)),
axis.text.x = element_text(family = "Helvetica", size=6.5, color = "black", vjust = 0.5),
axis.text.y = element_text(family = "Helvetica", size=6.5, color = "black", hjust = 0.5),
strip.text.x = element_text(family = "Helvetica", size=8, color = "black"),
strip.text.y = element_text(family = "Helvetica", size=8, color = "black", angle = -90),
strip.background = element_blank(),
axis.line = element_line(color = "black"),
legend.position = "None",
legend.background = element_blank(),
legend.key = element_blank(),
legend.title = element_blank(),
panel.background =  element_rect(fill = "transparent", colour = "black"),
panel.grid.major = element_line(colour = "transparent"),
panel.grid.minor = element_line(colour = "transparent"),
plot.background = element_rect(fill = "transparent", color = "transparent"),
plot.tag = element_text(family = "Helvetica", size = 12, face = "bold", color = "black"))
theme_set(mytheme_paper)
# define Scientific notation
labeli <- as_labeller(c(
europaea = "italic('N. europaea')",
PY1 = "italic('Nitrosomonas')~'sp. PY1'",
`10^5` = "10^5~'cells/mL'",
`10^3` = "10^3~'cells/mL'",
`10^1` = "10^1~'cells/mL'",
`10^0` = "10^0~'cells/mL'",
`supernatant` = "'CFS+'",
`no-supernatant` = "'CFS-'",
`supernatant 10%` = "'CFS+'",
`supernatant 0%` = "'CFS-'",
`catalase-` = "'CFS 0%,'~'catalase-'",
`1` = "'N = 1'",
`2` = "'N = 2'",
`3` = "'N = 3'",
`Cat+` = "'supernatant 0%'",
`Cat-` = "'supernatant 0%,'~'catalase-'"
), default = label_parsed)
folder_path = "./result/"
if (!dir.exists(folder_path)) {
dir.create(folder_path, recursive = TRUE)
}
label_vec <- c(
`10^5` = "10^5",
`10^3` = "10^3",
`10^1` = "10^1"
)
my_colors <- c("PY1" = "salmon", "europaea" = "royalblue",
"PY1.1" = "lightsalmon", "PY1.2" = "salmon", "PY1.3" = "salmon4",
"europaea.1" = "lightblue", "europaea.2" = "royalblue1", "europaea.3" = "navy"
)
my_shapes <- c("PY1.1" = 21, "PY1.2" = 22, "PY1.3" = 23,
"europaea.1" = 21, "europaea.2" = 22, "europaea.3" = 23
)
rep_labels <- c("PY1.1" = "1", "PY1.2" = "2", "PY1.3" = "3",
"europaea.1" = "1", "europaea.2" = "2", "europaea.3" = "3"
)
# set order
biomass_data$Specie <- factor(biomass_data$Specie, levels = c("PY1", "europaea"))
biomass_data$Condition <- factor(biomass_data$Condition, levels = c("no-supernatant", "supernatant"))
daughter_cell_pair$Specie <- factor(daughter_cell_pair$Specie, levels = c("PY1", "europaea"))
daughter_cell_pair$Condition <- factor(daughter_cell_pair$Condition, levels = c("no-supernatant", "supernatant", "supernatant 10%", "supernatant 0%"))
plot_time_vs_biomass_mergeRep <- function(data, specie){
data = data
if(nrow(data) == 0){
message(glue("Skipping: No data"))
return(NULL)
}
data <- data %>%
mutate(rep_key = interaction(Specie, as.character(replicate), sep="."))
time_vs_biomass_mergeRep <-
ggplot(data,
aes(x = Time, y = um2_biomass,
group = interaction(rep_key, as.character(FOV))
)) +
geom_line(aes(color = rep_key),
alpha = 0.6, linewidth = 0.4) +
geom_point(aes(fill = rep_key,
shape = rep_key
),
size = 1.0, alpha = 0.6,
color = "black", stroke = 0.4) +
scale_color_manual(name = "Biological replicate", values = my_colors, labels = rep_labels) +
scale_fill_manual(name = "Biological replicate", values = my_colors, labels = rep_labels) +
scale_shape_manual(name = "Biological replicate", values = my_shapes, labels = rep_labels) +
labs(
x = "Time (h)",
y = expression(paste( "Total cell area (", " ", mu, "m"^2, ")" ))
)
}
specie_list = c("europaea", "PY1")
biomass_plots <- list()
for (specie in specie_list){
data = subset(biomass_data, Condition != "supernatant" & Specie == specie)
biomass_plot <-
plot_time_vs_biomass_mergeRep(na.omit(data))
base_name <- "(exstra)_time_vs_biomass"
biomass_plot <- biomass_plot+mytheme_paper+
theme(legend.position = "inside",
legend.position.inside = c(0.03, 0.97),
legend.justification = c(0, 1),
legend.title = element_text(family = "Helvetica", size = 6, color = "black", margin = margin(b = 3)),
legend.key.height = unit(0.25, "cm"),
legend.spacing.y = unit(0, "cm")
)
biomass_plots[[specie]] <- biomass_plot
ggsave(file.path(folder_path, paste0(base_name, "_", specie,  ".svg")),
plot = biomass_plot, width = 2.4, height = 2.4, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, "_", specie, ".png")),
plot = biomass_plot, width = 2.4, height = 2.4, units = "in", device = "png", dpi = 600)
}
specie_list = c("PY1")
biomass_plots_CFS <- list()
for (specie in specie_list){
data = subset(biomass_data, Condition == "supernatant" & Specie == specie)
biomass_plot <-
plot_time_vs_biomass_mergeRep(na.omit(data))
base_name <- "(exstra)_time_vs_biomass_CFS"
biomass_plot <- biomass_plot+mytheme_paper
biomass_plots_CFS[[specie]] <- biomass_plot
ggsave(file.path(folder_path, paste0(base_name, "_", specie,  ".svg")),
plot = biomass_plot, width = 2.4, height = 2.4, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, "_", specie, ".png")),
plot = biomass_plot, width = 2.4, height = 2.4, units = "in", device = "png", dpi = 600)
}
