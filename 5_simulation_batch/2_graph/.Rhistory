library(patchwork)
lineplot       <- lineplot + labs(tag = "A")
boxplot        <- boxplot + labs(tag = "B")
lineplot_CFS   <- lineplot_CFS + labs(tag = "C")
boxplot_CFS    <- boxplot_CFS + labs(tag = "D")
fig4 <-
((lineplot / boxplot) |
(lineplot_CFS / boxplot_CFS)) +
plot_layout(widths = c(2, 1))
base_name = "fig4"
# 保存
ggsave(file.path(folder_path, paste0(base_name, ".svg")),
fig4, width = 7.2, height = 6.4, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, ".pdf")),
fig4, width = 7.2, height = 6.4, units = "in", device = "pdf", dpi = 600)
