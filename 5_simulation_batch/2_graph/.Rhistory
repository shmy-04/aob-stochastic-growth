mytheme_paper <-
theme(text = element_text(family = "Helvetica", size=8, color = "black"),
plot.title = element_text(family = "Helvetica", size=9.5, color = "black", face = "bold",
vjust = 1, hjust = 0),
axis.title.x = element_text(family = "Helvetica", size=8, color = "black",
margin = margin(t = 5)),
axis.title.y = element_text(family = "Helvetica", size=8, color = "black", angle = 90,
margin = margin(r = 5)),
axis.text.x = element_text(family = "Helvetica", size=6.5, color = "black", vjust = 0.5),
axis.text.y = element_text(family = "Helvetica", size=6.5, color = "black", hjust = 0.5),
strip.text.x = element_text(family = "Helvetica", size=8, color = "black"),
strip.text.y = element_text(family = "Helvetica", size=8, color = "black", angle = -90),
strip.background = element_blank(),
axis.line = element_line(color = "black"),
legend.position = "None",
legend.background = element_blank(),
legend.key = element_blank(),
legend.title = element_blank(),
panel.background =  element_rect(fill = "transparent", colour = "black"),
panel.grid.major = element_line(colour = "transparent"),
panel.grid.minor = element_line(colour = "transparent"),
plot.background = element_rect(fill = "transparent", color = "transparent"),
plot.tag = element_text(family = "Helvetica", size = 12, face = "bold", color = "black"))
theme_set(mytheme_paper)
# no-CFS
rawdata_PY1 <-
read.csv("../240217開始_PY1（bio3、論文用）/亜硝酸測定結果/まとめ_v1.csv")
rawdata_europaea <-
read.csv("../250307開始_europaea_酸素透過膜（bio3）/亜硝酸測定結果/まとめ_v1.csv")
rawdata_sup <-
read.csv("../241126開始_PY1_上清入り（bio3，論文用）/亜硝酸測定結果/まとめ_v2.csv")
rawdata_noSup <-
dplyr::bind_rows(rawdata_PY1, rawdata_europaea)
rawdata_merge = bind_rows(rawdata_noSup, rawdata_sup)
PY1_growth_rate_per_day = 0.23
europaea_growth_rate_per_day = 1.38
# PY1_yield = 33.5
# europaea_yield = 10.6
initial_concentrations <- list(
"N1" = 0.070957882,
"N2" = 0.0639502318, # 0.039015614,
"N3" = 0.063268077
)
rawdata_mutate <-
rawdata_merge %>%
group_by(Specie, CellDensity, N, Condition, ID) %>%
mutate(
Nitrite_production = case_when(
Specie == "PY1" & N == "1" & Condition == "supernatant 10%" ~ ifelse(Nitrite - initial_concentrations$N1 > 0,
Nitrite - initial_concentrations$N1, 0),
Specie == "PY1" & N == "2" & Condition == "supernatant 10%" ~ ifelse(Nitrite - initial_concentrations$N2 > 0,
Nitrite - initial_concentrations$N2, 0),
Specie == "PY1" & N == "3" & Condition == "supernatant 10%" ~ ifelse(Nitrite - initial_concentrations$N3 > 0,
Nitrite - initial_concentrations$N3, 0),
TRUE ~ Nitrite  # 条件外のデータはそのまま
),
Nitrite_OVF_count = cumsum(Nitrite_production >= 1),
generation = case_when(
Specie == "PY1" ~ Day / (log(2)/PY1_growth_rate_per_day),
Specie == "europaea" ~ Day / (log(2)/europaea_growth_rate_per_day)
)
) %>%
ungroup()
rawdata_mutate_2 <-
rawdata_mutate %>%
mutate(IF_population = ifelse(Nitrite_production > 0.25, 1, 0)) %>%
arrange(Specie, CellDensity, N, Condition, Day) %>%
group_by(Specie, CellDensity, N, Condition, Day) %>%
mutate(IF_population_Cumulative = sum(IF_population),
awake_well_ratio = IF_population_Cumulative/n()) %>% # 総合のウェル12個
select(Specie, CellDensity, N, Condition, Day, IF_population_Cumulative, awake_well_ratio) %>%
distinct()
rawdata_filter <-
rawdata_mutate %>%
filter(Specie == "PY1" & Condition == "Cat+" |
Specie == "europaea" & Condition=="normal" |
Specie == "PY1" & Condition == "supernatant 10%" |
Specie == "PY1" & Condition == "supernatant 0%") %>%
filter(Nitrite_OVF_count <= 1)
rawdata_filter_2 <-
rawdata_mutate_2 %>%
filter(Specie == "PY1" & Condition == "Cat+" |
Specie == "europaea" & Condition=="normal" |
Specie == "PY1" & Condition == "supernatant 10%" |
Specie == "PY1" & Condition == "supernatant 0%")
readr::write_csv(
rawdata_filter_2,
file = "cumulative_well_count_raw.csv"
)
rawdata_summarize <-
rawdata_filter_2 %>%
group_by(Specie, CellDensity, Condition, Day) %>%
filter(n_distinct(N) == 3) %>% # select N=3 data
summarise(mean = mean(awake_well_ratio),
sd = sd(awake_well_ratio),
n = n()) %>%
group_by(Specie) %>% # max_dayはSpeieごとに算出
mutate(max_day = max(Day))
# define Scientific notation
labeli <- as_labeller(c(
europaea = "italic('N. europaea')",
PY1 = "italic('Nitrosomonas')~'sp. PY1'",
# PY1 = "atop(italic('Nitrosomonas'), 'sp. PY1')",
`10^5` = "10^5",
`10^3` = "10^3",
`10^1` = "10^1",
`10^0` = "0",
`supernatant 10%` = "'CFS +'",
`supernatant 0%` = "'CFS -'",
`normal` = "'CFS -'",
`catalase-` = "'CFS -,'~'catalase-'",
`1` = "'N = 1'",
`2` = "'N = 2'",
`3` = "'N = 3'",
`Cat+` = "'CFS -'",
`Cat-` = "'CFS -,'~'catalase-'",
`PY1_Cat+` = "italic('Nitrosomonas')~'sp. PY1, CFS -'",
`europaea_normal` = "italic('N. europaea')~', CFS -'",
`PY1_supernatant 10%` = "italic('Nitrosomonas')~'sp. PY1, CFS +'"
), default = label_parsed)
folder_path = "./result_paper/"
if (!dir.exists(folder_path)) {
dir.create(folder_path, recursive = TRUE)
}
label_vec <- c(
`10^5` = "10^5",
`10^3` = "10^3",
`10^1` = "10^1",
`10^0` = "0"
)
# data <- subset(rawdata_filter_2, (N==1 & Condition != "supernatant 0%"))
data <- subset(rawdata_summarize, (Condition != "supernatant 0%" & Condition != "supernatant 10%"))
data$Specie_Condition <- paste(data$Specie, data$Condition, sep = "_")
# Specie の順序を設定
data$Specie <- factor(data$Specie, levels = c("PY1", "europaea"))
data$Condition <- factor(data$Condition, levels = c("Cat+", "normal", "supernatant 10%", "supernatant 0%"))
data$CellDensity <- factor(data$CellDensity, levels = c("10^5", "10^3", "10^1"))
data$Specie_Condition <- factor(data$Specie_Condition, levels = c("PY1_Cat+", "europaea_normal", "PY1_supernatant 10%"))
lineplot <-
ggplot(na.omit(data),
aes(x = Day, y = mean,
fill = Specie),
color = "black") +
geom_errorbar(aes(ymin = pmax(mean - sd, 0), ymax = pmin(mean + sd, 1),
width = max_day/40)) +
geom_line(alpha = 0.9 , linewidth = 0.25) +
geom_point(size = 1.5, shape = 21, alpha = 0.9, stroke = 0.5) +
scale_fill_manual(values = c("PY1" = "salmon", "europaea" =  "royalblue")) +
scale_y_continuous(limits = c(-0.05, 1.05),
breaks = seq(0, 1, by = 0.5)) +
labs(x = "Incubation time (day)",
y = "Fraction of wells\nproducing >0.25 mM nitrite",
title = "") +
# facet_nested(CellDensity ~ Condition+Specie,
#              labeller = labeli,
#              nest_line = TRUE,
#              scales = "free_x") +
facet_grid(CellDensity ~ Specie,
labeller = labeli,
scales = "free_x") +
mytheme_paper
# lineplot
# フォルダとベース名
base_name <- "fig4'A_cumulative_wells_>0.25mM_Nitrite"
ggsave(file.path(folder_path, paste0(base_name, ".svg")),
plot = lineplot, width = 4.8, height = 3.2, units = "in", device = "svg")
ggsave(file.path(folder_path, paste0(base_name, ".pdf")),
plot = lineplot, width = 4.8, height = 3.2, units = "in", device = "pdf", dpi = 600)
thresh <- 0.25
# 各IDごとに閾値到達時間を補間
time_thresh <-
rawdata_filter %>%
group_by(Specie, CellDensity, N, Condition, ID) %>%
summarise(
Day_thresh = {
df <- pick(everything()) %>%
na.omit() %>%
arrange(Day) %>%
distinct(Nitrite, .keep_all = TRUE)
if (max(df$Nitrite, na.rm = TRUE) >= thresh) {
approx(x = df$Nitrite, y = df$Day, xout = thresh)$y
} else {
NA_real_
}
},
max_day = max(pick(Day), na.rm = TRUE),
.groups = "drop"
) %>%
group_by(Specie, CellDensity, N, Condition) %>%
mutate(
mean_Day_thresh = mean(Day_thresh, na.rm = TRUE),
generalized_Day_thresh = Day_thresh / mean_Day_thresh,
) %>%
group_by(Specie, CellDensity, N, Condition) %>%
mutate(
generalized_max_day = max(max_day, na.rm = T) / mean_Day_thresh
)
# factor順序を整理
time_thresh$Specie <- factor(time_thresh$Specie, levels = c("PY1", "europaea"))
time_thresh$Condition <- factor(time_thresh$Condition, c("Cat+", "normal", "supernatant 10%", "supernatant 0%"))
time_thresh$CellDensity <- factor(time_thresh$CellDensity, levels = c("10^5", "10^3", "10^1"))
# SDを計算
sd_summary <-
time_thresh %>%
group_by(Specie, CellDensity, N, Condition) %>%
summarise(
sd = sd(generalized_Day_thresh, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(Condition) %>%
mutate(label = paste0("SD=", round(sd, 2)),
y_pos = 1 + max(sd, na.rm = TRUE) * 3.0) %>%
group_by(Specie, CellDensity, Condition) %>%
mutate(sd_mean = mean(sd))
library(broom)
fligner_by_N <-
time_thresh %>%
filter(CellDensity == "10^5",
Condition != "supernatant 0%",
Condition != "supernatant 10%") %>%
group_by(N) %>%
do(tidy(fligner.test(Day_thresh ~ Specie, data = .)))
target_N = 1
data = subset(time_thresh, (N==target_N & Condition!="supernatant 0%" & Condition != "supernatant 10%" & CellDensity != "10^0"))
data$Specie_Condition <- paste(data$Specie, data$Condition, sep = "_")
data$Specie_Condition <- factor(data$Specie_Condition, levels = c("PY1_Cat+", "europaea_normal", "PY1_supernatant 10%"))
# 観測値と欠測値を分ける
data_obs <- data %>% filter(!is.na(generalized_Day_thresh))
data_na  <- data %>% filter(is.na(generalized_Day_thresh)) %>%
mutate(generalized_max_day = replace_na(generalized_max_day, 1.0))
sd_summary_active = subset(sd_summary,
(N==target_N & Condition!="supernatant 0%" & Condition != "supernatant 10%" & CellDensity != "10^0"))
# 箱ひげ図 + jitter + CVラベル
boxplot <-
ggplot() +
# 箱ひげ図は観測値のみ
geom_boxplot(data = data_obs,
aes(x = CellDensity, y = generalized_Day_thresh,
fill = Specie),
outlier.shape = NA, alpha = 0.6, position = position_dodge(width = 0.8)) +
# jitter: 観測値
geom_jitter(data = data_obs,
aes(x = CellDensity, y = generalized_Day_thresh, fill = Specie),
width = 0.3, height = 0, size = 1, alpha = 0.8, shape = 16) +
# jitter: 欠測値を上限でプロット
geom_jitter(data = data_na,
aes(x = CellDensity, y = generalized_max_day,
fill = Specie, group = Specie),
width = 0.4, height = 0, size = 1, alpha = 0.8, shape = 4) +
# SDラベル
geom_text(data = sd_summary_active,
aes(x = CellDensity, y = y_pos,
group = Specie, label = label),
position = position_dodge(width = 0.8), vjust = 0, size = 2.5) +
scale_fill_manual(values = c("PY1" = "salmon", "europaea" = "royalblue")) +
scale_x_discrete(labels = function(x) parse(text = label_vec[x])) +
# scale_y_continuous(expand = expansion(mult = c(0.1, 0.1))) +
scale_y_continuous(limits = c(0.25, 2.55),
breaks = seq(0, 3.0, 0.5)) +
labs(x = expression("Initial cell density (" * cells~mL^{-1} * ")"),
y = "Normalized time to reach 0.25 mM nitrite",
shape = "Observation status") +
# facet_nested(. ~ Condition+Specie,
#              labeller = labeli,
#              nest_line = TRUE) +
facet_grid(. ~ Specie,
labeller = labeli) +
mytheme_paper
